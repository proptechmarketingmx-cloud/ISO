# Base de Datos PostgreSQL local
DATABASE_URL="postgresql://postgres:secret@localhost:5432/iso_p2p?schema=public"

# Token de seguridad compartido para sincronización entre nodos P2P.
# IMPORTANTE: Cambiar por una cadena secreta única compartida entre tus nodos.
SYNC_TOKEN="REEMPLAZAR_CON_TOKEN_SECRETO_UNICO"

# Puerto local del servidor (3000 por defecto, 3001 para segundo nodo en pruebas locales)
PORT=3000
