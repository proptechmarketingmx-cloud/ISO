// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TABLAS CATÁLOGO (Dinámicas)
// ============================================

model TipoPropiedad {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  descripcion String?
  activo      Boolean      @default(true)
  propiedades Propiedad[]
  
  @@map("tipos_propiedad")
}

model TipoOperacion {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique // Venta, Renta, Compra
  descripcion String?
  activo      Boolean      @default(true)
  propiedades Propiedad[]
  
  @@map("tipos_operacion")
}

// ============================================
// ESTADOS DE LEADS (Máquina de estados)
// ============================================

enum EstadoLead {
  NUEVO
  CONTACTADO
  CALIFICADO
  VISITA_AGENDADA
  PROPUESTA_ENVIADA
  NEGOCIACION
  CERRADO_GANADO
  CERRADO_PERDIDO
  DESCARTADO
}

// ============================================
// CLIENTES / LEADS
// ============================================

model Cliente {
  id                        Int          @id @default(autoincrement())
  version                   Int          @default(1) // Optimistic locking
  
  // Datos básicos
  nombre                    String
  apellidoPaterno           String?
  apellidoMaterno           String?
  telefono                  String?
  email                     String?      @unique
  curp                      String?      @unique
  rfc                       String?      @unique
  
  // Ubicación
  pais                      String?      @default("MX")
  estado                    String?
  municipio                 String?
  ciudad                    String?
  colonia                   String?
  codigoPostal              String?
  
  // Perfil financiero (para Matching)
  presupuestoMin            Float?
  presupuestoMax            Float?
  engancheDisponible        Float?
  capacidadCreditoMax       Float?
  ingresoMensual            Float?
  
  // Preferencias (para Matching)
  tipoOperacionDeseada      String?      // ID de TipoOperacion
  tipoPropiedadDeseada      String?      // ID de TipoPropiedad
  recamarasMin              Int?
  banosMin                  Float?
  m2TerrenoMin              Float?
  m2ConstruccionMin         Float?
  ubicacionesPreferidas     Json?        // Array de ciudades/colonias
  
  // Sistema de Referidos (CNA)
  referidoPorClienteId      Int?         // Opción B: obligatorio después de crear
  referidoPorAsesorId       String?      // Si un asesor lo refirió
  esReferidoObligatorio     Boolean      @default(false) // Flag para validar
  
  // CNA Scoring
  scoreCna                  Float        @default(0)
  totalReferidosGenerados   Int          @default(0)
  valorVentasReferidos      Float        @default(0)
  
  // Metadata
  estadoLead                EstadoLead   @default(NUEVO)
  fechaRegistro             DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  
  // Relaciones
  referidoPorCliente        Cliente?     @relation("ReferidosCliente", fields: [referidoPorClienteId], references: [id])
  referidosClientes         Cliente[]    @relation("ReferidosCliente")
  referidoPorAsesor         Asesor?      @relation("ReferidosAsesor", fields: [referidoPorAsesorId], references: [id])
  referidosAsesores         Asesor[]     @relation("ReferidosAsesor")
  
  oportunidades           Oportunidad[]
  compatibilidades        CompatibilidadClientePropiedad[]
  
  @@index([estadoLead])
  @@index([scoreCna])
  @@map("clientes")
}

// ============================================
// ASESORES
// ============================================

model Asesor {
  id                        String       @id @default(uuid())
  version                   Int          @default(1) // Optimistic locking
  
  nombre                    String
  email                     String       @unique
  telefono                  String?
  estado                    String?
  activo                    Boolean      @default(true)
  
  // CNA Scoring para Asesores
  scoreCna                  Float        @default(0)
  totalReferidosGenerados   Int          @default(0)
  valorVentasReferidos      Float        @default(0)
  
  // Metadata
  fechaRegistro             DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  
  // Relaciones
  clientesReferidos         Cliente[]    @relation("ReferidosAsesor")
  propiedades             Propiedad[]
  oportunidades           Oportunidad[]
  
  @@map("asesores")
}

// ============================================
// PROPIEDADES
// ============================================

model Propiedad {
  id                        Int          @id @default(autoincrement())
  version                   Int          @default(1) // Optimistic locking
  
  // Datos básicos
  titulo                    String
  descripcion               String?
  
  // Clasificación
  tipoPropiedadId           Int
  tipoOperacionId           Int
  
  // Ubicación
  pais                      String?      @default("MX")
  estado                    String?
  municipio                 String?
  ciudad                    String?
  colonia                   String?
  codigoPostal              String?
  direccion                 String?
  
  // Características físicas
  m2Terreno                 Float?
  m2Construccion            Float?
  recamaras                 Int?
  banos                     Float?
  estacionamientos          Int?
  niveles                   Int?
  antiguedad                Int?
  
  // Características específicas (JSONB para flexibilidad)
  caracteristicasEspec      Json?        // Ej: {"frente": 10, "fondo": 20} para terrenos
  
  // Amenidades (para Matching)
  amenidades                Json?        // Array: ["Alberca", "Seguridad 24/7", etc.]
  
  // Datos financieros
  precio                    Float
  esNegociable              Boolean      @default(false)
  comision                  Float?
  
  // Datos legales
  escriturasListas          Boolean      @default(false)
  libreGravamen             Boolean      @default(false)
  
  // Asesor asignado
  asesorId                  String?
  
  // Metadata
  fechaRegistro             DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  
  // Relaciones
  tipoPropiedad             TipoPropiedad @relation(fields: [tipoPropiedadId], references: [id])
  tipoOperacion             TipoOperacion @relation(fields: [tipoOperacionId], references: [id])
  asesor                    Asesor?      @relation(fields: [asesorId], references: [id])
  
  oportunidades           Oportunidad[]
  compatibilidades        CompatibilidadClientePropiedad[]
  
  @@index([tipoPropiedadId])
  @@index([tipoOperacionId])
  @@index([precio])
  @@map("propiedades")
}

// ============================================
// OPORTUNIDADES (Ventas potenciales)
// ============================================

model Oportunidad {
  id                        Int          @id @default(autoincrement())
  
  clienteId                 Int
  propiedadId               Int
  asesorId                  String?
  
  estado                    EstadoLead   @default(NUEVO)
  valorEstimado             Float?
  probabilidadCierre        Int          @default(10) // 10-100
  
  notas                     String?
  fechaCierreEstimada       DateTime?
  
  fechaCreacion             DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  
  // Relaciones
  cliente                   Cliente      @relation(fields: [clienteId], references: [id])
  propiedad                 Propiedad    @relation(fields: [propiedadId], references: [id])
  asesor                    Asesor?      @relation(fields: [asesorId], references: [id])
  
  @@index([clienteId])
  @@index([propiedadId])
  @@index([estado])
  @@map("oportunidades")
}

// ============================================
// MATCHING: Compatibilidad Cliente-Propiedad
// ============================================

model CompatibilidadClientePropiedad {
  id                        Int          @id @default(autoincrement())
  
  clienteId                 Int
  propiedadId               Int
  
  // Scores calculados automáticamente
  scoreTotal                Float
  scorePrecio               Float?       // Qué tan bien encaja el precio
  scoreUbicacion            Float?       // Coincidencia de ubicación
  scoreCaracteristicas      Float?       // Recámaras, baños, m2
  scoreAmenidades           Float?       // Coincidencia de amenidades
  
  // Metadata
  fechaCalculo              DateTime     @default(now())
  
  // Relaciones
  cliente                   Cliente      @relation(fields: [clienteId], references: [id])
  propiedad                 Propiedad    @relation(fields: [propiedadId], references: [id])
  
  @@unique([clienteId, propiedadId])
  @@index([scoreTotal])
  @@map("compatibilidad_cliente_propiedad")
}